# NEXCUST — DEMONSTRATION environment. Synthetic data only.
DATABASE_URL="postgresql://nexcust:nexcust@localhost:5432/nexcust?schema=public"
# Used by migrations. Locally the same as DATABASE_URL; hosted, the session (non-transaction) connection.
DIRECT_URL="postgresql://nexcust:nexcust@localhost:5432/nexcust?schema=public"
# API
API_PORT=4000
SESSION_COOKIE_NAME=nx_session
SESSION_TTL_HOURS=8
# Comma-separated origins allowed to send state-changing requests (CSRF origin check)
WEB_ORIGIN=http://localhost:3000
# "true" only behind HTTPS (demo/prod). Sets the Secure flag on the session cookie.
COOKIE_SECURE=false
# Web -> API proxy target (server side only)
API_INTERNAL_URL=http://localhost:4000


# Seed password for all synthetic demo accounts (never reuse outside the demo)
DEMO_PASSWORD=Demo!Pass2026
# Rate limits (requests per minute, per client IP)
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
# Hours allowed before a detained person must be produced before a court (configurable rule)
CUSTODY_COURT_DEADLINE_HOURS=48
# Hosted only: shared secret the web tier adds to every API request (leave empty locally)
API_GATEWAY_SECRET=
# Optional password gate in front of the whole site (off unless DEMO_GATE_ENABLED=true)
DEMO_GATE_ENABLED=false
DEMO_GATE_USER=
DEMO_GATE_PASSWORD=
# Invitation emails through Resend (both needed; without them the administrator copies the link)
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
# Public address used in invitation links (defaults to the first WEB_ORIGIN)
APP_BASE_URL=
